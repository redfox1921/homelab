# =============================================================================
# Paperless-ngx – Beispielkonfiguration
# Kopieren nach ".env" und die Platzhalter ersetzen. 
# =============================================================================

# --- Benutzer-Zuordnung im Container -----------------------------------------
# UID/GID des Benutzers, dem die gemounteten Ordner gehören
# (auf dem Host prüfen mit: id)
USERMAP_UID=1000
USERMAP_GID=1000

# --- Geheimnisse (zwingend ersetzen) -----------------------------------------
# Zufälliger, langer Schlüssel. Erzeugen mit:  openssl rand -base64 48
PAPERLESS_SECRET_KEY=LANGEN_ZUFALLSWERT_ERSETZEN

# Datenbank-Passwort. Erzeugen mit:  openssl rand -hex 24
# Muss mit dem Passwort in Postgres übereinstimmen.
PAPERLESS_DB_PASSWORD=PASSWORT_SETZEN

# --- Allgemein ----------------------------------------------------------------
PAPERLESS_TIME_ZONE=Europe/Berlin
PAPERLESS_OCR_LANGUAGE=deu+eng

# Öffentliche Adresse von Paperless (ohne Slash am Ende)
PAPERLESS_URL=https://paperless.example.com

# --- Single Sign-On über Pocket ID (OIDC) ------------------------------------
# Redirect-URI im OIDC-Client von Pocket ID:
#   https://paperless.example.com/accounts/oidc/pocket-id/login/callback/
# Der Wert bei "provider_id" muss dem Teil "pocket-id" in dieser URL entsprechen.
# "server_url" ist die Adresse von Pocket ID, ohne Pfad.
# Das JSON muss in einer einzigen Zeile stehen.
PAPERLESS_APPS=allauth.socialaccount.providers.openid_connect
PAPERLESS_SOCIALACCOUNT_PROVIDERS={"openid_connect":{"SCOPE":["openid","profile","email"],"OAUTH_PKCE_ENABLED":true,"APPS":[{"provider_id":"pocket-id","name":"Pocket ID","client_id":"CLIENT_ID_ERSETZEN","secret":"CLIENT_SECRET_ERSETZEN","settings":{"server_url":"https://id.example.com"}}]}}

# Neue Pocket-ID-Nutzer automatisch als Paperless-Benutzer anlegen.
# Auf "false" setzen, wenn nur vorhandene Konten sich anmelden dürfen.
PAPERLESS_SOCIAL_AUTO_SIGNUP=true
PAPERLESS_SOCIALACCOUNT_ALLOW_SIGNUPS=true
